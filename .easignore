# Dependencies are installed by EAS from the lockfile.
node_modules/
**/node_modules/

# Expo and generated outputs.
.expo/
dist/
web-build/
coverage/
expo-env.d.ts
*.tsbuildinfo

# Native projects are generated by Expo Prebuild from app.config.ts.
/android/
/ios/
.kotlin/
*.orig.*

# Credentials and local build configuration never belong in the upload.
.env*
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.pem

# Local tooling, documentation, backend code, and tests are not mobile inputs.
/.git/
/.github/
/.codex/
/.agents/
/.superstack/
/docs/
/perpal_docs_gitignore_it/
/workers/
/scripts/
/tests/
**/*.test.ts
**/*.test.tsx
**/*.spec.ts
**/*.spec.tsx
/AGENTS.md
/IMPLEMENTATION_STATUS.md
/jest.config.js
/eslint.config.js

# Local artifacts and OS/editor noise.
*.apk
*.aab
*.ipa
*.log
npm-debug.*
yarn-debug.*
yarn-error.*
.metro-health-check*
.DS_Store

# Assets not referenced by app.config.ts or the mobile module graph.
/assets/AppIcon/
/assets/fonts/Manrope-VariableFont_wght.ttf
/assets/fonts/Lexend*
/assets/fonts/Prata-Regular.ttf
/assets/fonts/poppins/*
!/assets/fonts/poppins/Poppins-Regular.ttf
!/assets/fonts/poppins/Poppins-Medium.ttf
!/assets/fonts/poppins/Poppins-SemiBold.ttf
!/assets/fonts/poppins/Poppins-Bold.ttf
