# Dependencies are installed by EAS from the lockfile.
node_modules/
**/node_modules/

# Expo and generated outputs.
.expo/
dist/
web-build/
coverage/
expo-env.d.ts
*.tsbuildinfo

# Native projects are generated by Expo Prebuild from app.config.ts.
/android/
/ios/
.kotlin/
*.orig.*

# Credentials and local build configuration never belong in the upload.
.env*
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.pem

# Local tooling, documentation, backend code, and tests are not mobile inputs.
/.git/
/.github/
/.codex/
/.agents/
/.superstack/
/docs/
/perpal_docs_gitignore_it/
/workers/
/scripts/
/tests/
**/*.test.ts
**/*.test.tsx
**/*.spec.ts
**/*.spec.tsx
/AGENTS.md
/IMPLEMENTATION_STATUS.md
/jest.config.js
/eslint.config.js

# Presentation exports kept beside the app, such as the pitch deck. Native builds need no
# root-level HTML, and the deck alone was 11 MB of every upload.
/*.html

# Local artifacts and OS/editor noise.
*.apk
*.aab
*.ipa
*.log
npm-debug.*
yarn-debug.*
yarn-error.*
.metro-health-check*
.DS_Store
Thumbs.db

# Editor, IDE and agent state.
/.vscode/
/.idea/
/.cursor/
/.claude/
/.kiro/
/.zed/
/.fleet/

# Scratch, backup and temporary files.
/tmp/
/temp/
*.tmp
*.temp
*.swp
*.swo
*~
*.bak
*.orig
**/__tests__/

# Archives, heap dumps and signing material that can land in the tree by accident.
*.zip
*.tar
*.tar.gz
*.tgz
*.hprof
*.keystore
