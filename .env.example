# Perpal — build-time mobile configuration.
#
# Copy to `.env.local` (gitignored) and fill in. Every value here is embedded in
# the mobile binary, so it must be safe to publish. Credentials, provider secrets
# and signing material belong in Worker secrets or device secure storage, never
# here.
#
# The app validates this schema at startup and fails closed when a required
# value is missing or malformed. There are no endpoint fallbacks in source.

# --- Privy (public identifiers only) ---
EXPO_PUBLIC_PRIVY_APP_ID=
EXPO_PUBLIC_PRIVY_CLIENT_ID=

# --- Backend (Cloudflare Worker) ---
# Origin of the Perpal Worker. No trailing slash.
EXPO_PUBLIC_API_ORIGIN=

# --- Solana ---
# One of: mainnet | devnet
EXPO_PUBLIC_SOLANA_CLUSTER=
# RPC is proxied through the Worker gateway; this is the app-facing path.
EXPO_PUBLIC_RPC_PATH=

# --- Observability ---
# Telemetry is opt-in and configured, never hardcoded.
EXPO_PUBLIC_TELEMETRY_ENABLED=false
EXPO_PUBLIC_TELEMETRY_SAMPLE_RATE=0
