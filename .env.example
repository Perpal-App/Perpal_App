# Perpal — public mainnet mobile configuration.
# Copy to `.env.mainnet`, fill in public Privy identifiers, then run
# `npm run env:mainnet`. Provider credentials remain Worker secrets.

EXPO_PUBLIC_PRIVY_APP_ID=
EXPO_PUBLIC_PRIVY_CLIENT_ID=

EXPO_PUBLIC_SOLANA_CLUSTER=mainnet
EXPO_PUBLIC_VELOCITY_PROGRAM_ID=vELoC1audYbSYVRXn1vPaV8Axoa9oU6BYmNGZZBDZ1P
EXPO_PUBLIC_FLASH_PROGRAM_ID=FLASH6Lo6h3iasJKWDs2F8TkW2UKf3s15C8PMGuVfgBn
EXPO_PUBLIC_FLASH_ER_RPC=https://flash.magicblock.xyz

EXPO_PUBLIC_UMBRA_INDEXER_URL=https://utxo-indexer.api.umbraprivacy.com
EXPO_PUBLIC_UMBRA_RELAYER_URL=https://relayer.api.umbraprivacy.com
EXPO_PUBLIC_UMBRA_ZK_ASSET_BASE_URL=https://zk.api.umbraprivacy.com

EXPO_PUBLIC_API_ORIGIN=
EXPO_PUBLIC_RPC_PATH=/v1/rpc
EXPO_PUBLIC_PUBLIC_RPC_PATH=/v1/rpc/public
EXPO_PUBLIC_MARKET_DATA_PATH=/v1/markets
EXPO_PUBLIC_MARKET_STREAM_PATH=/v1/markets/stream

EXPO_PUBLIC_TELEMETRY_ENABLED=false
EXPO_PUBLIC_TELEMETRY_SAMPLE_RATE=0
