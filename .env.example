# Perpal — build-time mobile configuration.
#
# Copy to `.env.devnet` / `.env.mainnet` (both gitignored) and fill in. Every value
# here is embedded in the mobile binary, so it must be safe to publish. Provider
# API keys, Upstash tokens and signing material belong in Worker secrets or device
# secure storage, never here.
#
# The app validates this schema at startup and fails closed, listing the exact
# variable names. There are no endpoint or cluster fallbacks in source.

# --- Build target ---
# Which perps venue this binary is built against. This is a build target, not a
# runtime toggle: only one venue adapter is bundled per build.
#   drift-devnet  | Drift Protocol v2 on Solana devnet
#   flash-mainnet | Flash Trade v2 on Solana mainnet
EXPO_PUBLIC_PERPS_VENUE=

# --- Privy (public identifiers only) ---
EXPO_PUBLIC_PRIVY_APP_ID=
EXPO_PUBLIC_PRIVY_CLIENT_ID=

# --- Backend (Cloudflare Worker) ---
# Origin of the Perpal Worker for this target. https, no trailing slash.
# Use a different Worker per target; never one Worker serving both clusters.
EXPO_PUBLIC_API_ORIGIN=

# --- Solana ---
# One of: devnet | mainnet
# Declared explicitly and cross-checked against EXPO_PUBLIC_PERPS_VENUE, so a
# half-edited file is rejected rather than resolved in favour of one of them.
EXPO_PUBLIC_SOLANA_CLUSTER=
# Worker path that proxies Solana JSON-RPC. Leading slash, no trailing slash.
# Provider keys stay server-side, so the app never holds an RPC credential.
EXPO_PUBLIC_RPC_PATH=

# --- Observability ---
# Telemetry is opt-in and configured, never hardcoded.
EXPO_PUBLIC_TELEMETRY_ENABLED=false
EXPO_PUBLIC_TELEMETRY_SAMPLE_RATE=0
