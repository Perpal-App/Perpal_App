{
  "name": "perpal",
  "version": "0.1.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start --dev-client",
    "start:clear": "expo start --dev-client --clear",
    "android": "expo run:android",
    "android:logs": "adb logcat ReactNativeJS:V ReactNative:V '*:S'",
    "android:clear": "npm run clean && expo run:android --no-build-cache",
    "android:build": "expo run:android --no-build-cache --no-bundler",
    "android:release": "expo run:android --variant release",
    "ios": "expo run:ios",
    "ios:clear": "npm run clean && expo run:ios --no-build-cache",
    "ios:build": "expo run:ios --no-build-cache --no-bundler",
    "ios:device": "expo run:ios --device",
    "ios:release": "expo run:ios --configuration Release",
    "prebuild": "expo prebuild",
    "prebuild:clean": "expo prebuild --clean",
    "rebuild:android": "node scripts/clean.mjs --native && expo prebuild --clean -p android && expo run:android --no-build-cache",
    "rebuild:ios": "node scripts/clean.mjs --native && expo prebuild --clean -p ios && expo run:ios --no-build-cache",
    "clean": "node scripts/clean.mjs",
    "clean:deep": "node scripts/clean.mjs --deep",
    "clean:native": "node scripts/clean.mjs --native",
    "clean:modules": "node scripts/clean.mjs --modules",
    "emu:list": "emulator -list-avds",
    "emu:start": "emulator -avd",
    "postinstall": "patch-package",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "smoke:gateway": "node scripts/smoke-gateway.mjs",
    "env:mainnet": "node scripts/use-env.mjs mainnet",
    "lint": "eslint .",
    "check:file-size": "node scripts/check-file-size.mjs",
    "validate": "npm run typecheck && npm run lint && npm run deps:check && npm run check:file-size",
    "deps:check": "expo install --check",
    "doctor": "expo-doctor",
    "generate:chart": "node scripts/generate-tradingview-chart.mjs"
  },
  "dependencies": {
    "@ethersproject/shims": "^5.8.0",
    "@noble/curves": "^2.2.0",
    "@noble/hashes": "^2.2.0",
    "@privy-io/expo": "0.70.6",
    "@privy-io/expo-native-extensions": "0.0.12",
    "@scure/base": "^2.2.0",
    "@solana/kit": "2.3.0",
    "@solana/spl-token": "^0.4.15",
    "@solana/web3.js": "1.98.0",
    "@solana/webcrypto-ed25519-polyfill": "^7.0.0",
    "@umbra-privacy/rn-zk-prover": "5.0.0",
    "@umbra-privacy/sdk": "5.0.0-rc.6",
    "buffer": "6.0.3",
    "events": "3.3.0",
    "expo": "~57.0.14",
    "expo-apple-authentication": "~57.0.1",
    "expo-application": "~57.0.2",
    "expo-asset": "~57.0.12",
    "expo-blur": "~57.0.2",
    "expo-build-properties": "~57.0.12",
    "expo-clipboard": "~57.0.1",
    "expo-constants": "~57.0.12",
    "expo-crypto": "~57.0.1",
    "expo-dev-client": "~57.0.13",
    "expo-file-system": "~57.0.1",
    "expo-font": "~57.0.1",
    "expo-haptics": "~57.0.1",
    "expo-image": "~57.0.3",
    "expo-linear-gradient": "~57.0.1",
    "expo-linking": "~57.0.6",
    "expo-local-authentication": "~57.0.2",
    "expo-navigation-bar": "~57.0.2",
    "expo-observe": "~57.0.19",
    "expo-router": "~57.0.14",
    "expo-screen-orientation": "~57.0.1",
    "expo-secure-store": "~57.0.1",
    "expo-splash-screen": "~57.0.7",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.2",
    "expo-updates": "~57.0.15",
    "expo-web-browser": "~57.0.2",
    "fast-text-encoding": "^1.0.6",
    "lightweight-charts": "5.2.0",
    "lottie-react-native": "~7.3.8",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-get-random-values": "~1.11.0",
    "react-native-mmkv": "4.3.2",
    "react-native-nitro-modules": "0.36.5",
    "react-native-passkeys": "^0.4.0",
    "react-native-qrcode-styled": "0.3.3",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-webview": "13.16.1",
    "react-native-worklets": "0.10.1",
    "snarkjs": "0.7.6",
    "viem": "2.55.5"
  },
  "devDependencies": {
    "@types/jest": "29.5.14",
    "@types/react": "~19.2.2",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~57.0.1",
    "jest": "29.7.0",
    "jest-expo": "~57.0.4",
    "patch-package": "^8.0.1",
    "typescript": "~6.0.3"
  }
}
